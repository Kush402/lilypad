# ─────────────────────────────────────────────────────────────
# Lilypad environment — copy to .env and adjust for your machine
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# Public URL clients use to reach the backend (mobile scans this in the QR).
# On real internet use https://api.yourdomain.com; for LAN dev use your machine IP.
PUBLIC_BASE_URL=http://localhost:8080
# WebSocket signaling URL advertised to clients (M2+).
SIGNALING_URL=ws://localhost:8080/ws/signal
# Production MUST use https:// / wss:// — loadEnv() refuses to boot with
# NODE_ENV=production otherwise (plaintext signaling carries the pairing
# handshake and every SDP/ICE exchange unencrypted).

# How far to trust X-Forwarded-For/X-Forwarded-Proto when behind a reverse
# proxy or load balancer. Empty (default) = trust none, matching a directly-
# exposed dev server. Set to a hop count (e.g. "1") or an IP/CIDR allowlist
# (e.g. "10.0.0.0/8") once you know your real proxy topology — NOT "true":
# blindly trusting every hop lets a client spoof its own source IP and dodge
# per-IP rate limiting.
TRUST_PROXY=

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=lilypad
POSTGRES_PASSWORD=lilypad_dev_password
POSTGRES_DB=lilypad
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgres://lilypad:lilypad_dev_password@localhost:5432/lilypad

# ── Redis ────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Production MUST include a password (e.g. redis://:secret@host:6379) —
# loadEnv() refuses to boot with NODE_ENV=production otherwise. Redis holds
# pairing-token and live room-routing state; unauthenticated access to it is
# a full session-hijack surface.

# ── Pairing / sessions ───────────────────────────────────────
# Single-use QR token lifetime in seconds (spec: 60s).
PAIRING_TOKEN_TTL_SECONDS=60

# ── coturn (STUN/TURN) — used from M2 onward ─────────────────
TURN_REALM=lilypad.local
TURN_SECRET=lilypad_dev_turn_secret
# The public IP coturn advertises. Use 127.0.0.1 for local-only dev.
TURN_EXTERNAL_IP=127.0.0.1
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# ICE servers JSON the clients use (STUN first, TURN fallback).
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478
