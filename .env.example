# ─────────────────────────────────────────────────────────────
# Lilypad environment — copy to .env and adjust for your machine
# ─────────────────────────────────────────────────────────────

# ── Backend ──────────────────────────────────────────────────
NODE_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8080
# Public URL clients use to reach the backend (mobile scans this in the QR).
# LEAVE UNSET for LAN dev: the backend auto-detects the machine's LAN IP at
# boot (a pinned IP silently breaks pairing when the network changes).
# Production: set explicitly, e.g. https://api.yourdomain.com
#PUBLIC_BASE_URL=
# WebSocket signaling URL advertised to clients. Same rule: leave unset for
# LAN dev (auto-detected); set wss://... explicitly in production.
#SIGNALING_URL=
# Production MUST use https:// / wss:// — loadEnv() refuses to boot with
# NODE_ENV=production otherwise (plaintext signaling carries the pairing
# handshake and every SDP/ICE exchange unencrypted).

# How far to trust X-Forwarded-For/X-Forwarded-Proto when behind a reverse
# proxy or load balancer. Empty (default) = trust none, matching a directly-
# exposed dev server. Set to a hop count (e.g. "1") or an IP/CIDR allowlist
# (e.g. "10.0.0.0/8") once you know your real proxy topology — NOT "true":
# blindly trusting every hop lets a client spoof its own source IP and dodge
# per-IP rate limiting.
TRUST_PROXY=

# ── Postgres ─────────────────────────────────────────────────
POSTGRES_USER=lilypad
POSTGRES_PASSWORD=lilypad_dev_password
POSTGRES_DB=lilypad
POSTGRES_PORT=5432
DATABASE_URL=postgres://lilypad:lilypad_dev_password@localhost:5432/lilypad

# ── Redis ────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379
# Production MUST include a password (e.g. redis://:secret@host:6379) —
# loadEnv() refuses to boot with NODE_ENV=production otherwise. Redis holds
# pairing-token and live room-routing state; unauthenticated access to it is
# a full session-hijack surface.

# ── Pairing / sessions ───────────────────────────────────────
# Single-use QR token lifetime in seconds (spec: 60s).
PAIRING_TOKEN_TTL_SECONDS=60

# ── coturn (STUN/TURN) — used from M2 onward ─────────────────
# NOTE: the dev docker-compose coturn reads infra/coturn/turnserver.conf,
# which hardcodes realm/external-ip for local use — TURN_REALM and
# TURN_EXTERNAL_IP below document what your PRODUCTION turnserver.conf must
# be configured with (they are not interpolated into the dev conf).
TURN_REALM=lilypad.local
TURN_SECRET=lilypad_dev_turn_secret
TURN_EXTERNAL_IP=127.0.0.1
TURN_PORT=3478
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
# ICE servers JSON the clients use (STUN first, TURN fallback).
STUN_URL=stun:localhost:3478
TURN_URL=turn:localhost:3478

# Publicly-reachable TURN relay — REQUIRED for cellular / off-Wi-Fi sessions.
# The local coturn above is unreachable off-LAN, so without a public relay a
# phone on cellular can only form a direct STUN path, which dies on the first
# NAT rebind (works ~1 min, then drops). Set all three from a free relay
# (e.g. metered.ca free tier) or your own deployed coturn's public address +
# a static credential. Empty = LAN / same-Wi-Fi only.
PUBLIC_TURN_URL=
PUBLIC_TURN_USERNAME=
PUBLIC_TURN_CREDENTIAL=

# Force both peers onto relay-only ICE (iceTransportPolicy: 'relay'),
# eliminating the fragile direct srflx↔srflx pair a CGNAT rebind can break
# over cellular. set true only after a dedicated TURN relay is deployed —
# see infra/coturn-prod/README.md. Forcing relay onto the free/shared relay
# above would break sessions that today succeed via a direct path.
FORCE_RELAY=false

# ── Internet reach ───────────────────────────────────────────
# PREFERRED: a NAMED tunnel on a permanent hostname — see
# infra/cloudflared/lilypad.yml and docs/RUNBOOK.md. Pin PUBLIC_BASE_URL and
# SIGNALING_URL to that hostname above and leave TUNNEL unset. A stable
# hostname is what makes cellular testing, OAuth redirects, and deep links
# possible at all; a quick tunnel's rotating URL cannot support any of them.
#
# FALLBACK (throwaway, no domain needed): set TUNNEL=1 (and `brew install cloudflared`)
# and the backend spawns a Cloudflare quick tunnel at boot — QR codes then
# advertise its https/wss URLs so the phone can pair from anywhere with no
# deployed backend. Signaling only; media negotiates via ICE (public STUN
# fallback is always advertised; symmetric NATs still want deployed TURN).
# Under the tunnel, run the backend BUILT + STARTED, not `dev` (tsx watch): a
# watch restart mints a NEW quick-tunnel URL, so the phone that just paired is
# left signaling a dead host (pairs, connects ~1s, then silence). Use:
#   pnpm --filter @lilypad/backend build && pnpm --filter @lilypad/backend start
#TUNNEL=1

# ── Accounts + device identity (M8) ──────────────────────────
# Signs every access token. Symmetric on purpose — only this backend ever
# verifies them. Anyone who can guess this can mint a token for any account
# and any device, so production refuses to boot with the dev value or with
# anything under 32 characters. Generate: openssl rand -hex 32
#AUTH_TOKEN_SECRET=
# Accepted `aud` values for Apple/Google ID tokens, comma-separated. Each
# provider issues a DIFFERENT client id per platform (iOS bundle id, Android
# client id, web client id, Apple Services ID) and this check is what stops a
# token minted for someone else's app from signing its bearer in here — so
# list every client id you actually ship. Empty = that provider is not
# configured, and its route answers 503 instead of pretending to work.
#APPLE_CLIENT_IDS=com.takedia.lilypad,com.takedia.lilypad.web
#GOOGLE_CLIENT_IDS=…apps.googleusercontent.com

# Extra hosts a device proof may name, beyond the ones this server advertises
# (PUBLIC_BASE_URL and the live advertised URL). Comma-separated hosts or URLs.
#
# A v2 device proof signs the host it is for and the server refuses any other
# (ADR-0002) — that refusal is what stops a hostile host relaying a challenge
# and replaying the signature. Empty is the normal case; it is NOT a fallback
# to "accept anything". See docs/operations.md before releasing clients.
DEVICE_PROOF_HOSTS=

# ── Observability / hardening ────────────────────────────────
# Bearer token protecting GET /metrics. Optional in dev; REQUIRED in
# production (boot refuses without it).
#METRICS_BEARER_TOKEN=
# Comma-separated browser origins allowed by CORS (e.g. a deployed admin
# SPA). Empty = no cross-origin browser clients (the default is safe).
#ALLOWED_ORIGINS=
# pino log level for the backend (default: info).
#LOG_LEVEL=info
