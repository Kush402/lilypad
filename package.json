{
  "name": "lilypad",
  "private": true,
  "version": "0.1.0",
  "description": "Lilypad \u2014 internet-first, phone-first remote laptop control",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "bootstrap": "node scripts/bootstrap.mjs",
    "docs:check": "node scripts/docs-check.mjs",
    "e2e:audit": "node scripts/e2e-audit.mjs",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "release": "node scripts/release.mjs",
    "clean": "node scripts/clean.mjs",
    "clean:build": "node scripts/clean.mjs build",
    "clean:cargo": "node scripts/clean.mjs cargo",
    "clean:mobile": "node scripts/clean.mjs mobile",
    "clean:deps": "node scripts/clean.mjs deps",
    "clean:all": "node scripts/clean.mjs all",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "rust:fmt": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "rust:check": "cargo fmt --manifest-path apps/desktop/src-tauri/Cargo.toml --check && CARGO_TARGET_DIR=apps/desktop/src-tauri/target/clippy cargo clippy --manifest-path apps/desktop/src-tauri/Cargo.toml --all-targets -- -D warnings && cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm docs:check && pnpm rust:check",
    "infra:up": "docker compose -f infra/docker-compose.yml up -d",
    "infra:down": "docker compose -f infra/docker-compose.yml down",
    "infra:logs": "docker compose -f infra/docker-compose.yml logs -f"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "eslint": "^9.18.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=4.0.0 <5.0.9": "5.0.9",
      "esbuild@<0.25.0": "^0.25.0",
      "fast-uri@<3.1.5": "3.1.5",
      "fast-uri@>=4.0.0 <4.1.2": "4.1.2",
      "fast-xml-parser@<5.7.0": "^5.7.0",
      "find-my-way@<9.7.0": "9.7.0",
      "js-yaml@<3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "nanoid@<3.3.16": "3.3.18",
      "postcss@<8.5.18": "8.5.26"
    },
    "auditConfig": {
      "ignoreGhsas": [
        "GHSA-w3rx-r6r6-pgpr",
        "GHSA-5p2g-fcmc-qvqq"
      ]
    }
  }
}
