{
  "name": "@lilypad/desktop",
  "version": "0.1.20",
  "description": "Lilypad desktop app (Tauri v2 + React)",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "build:vite": "tsc --noEmit -p tsconfig.json && vite build",
    "dev": "node ../../scripts/run-tauri.mjs dev",
    "build": "pnpm build:vite",
    "tauri:build": "node ../../scripts/run-tauri.mjs build",
    "tauri": "node ../../scripts/run-tauri.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist src-tauri/target *.tsbuildinfo"
  },
  "dependencies": {
    "@lilypad/design": "workspace:*",
    "@tauri-apps/api": "^2.2.0",
    "@tauri-apps/plugin-process": "^2.2.0",
    "@tauri-apps/plugin-updater": "^2.3.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.2.5",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "typescript": "^5.7.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  }
}
