{
  "name": "@lilypad/mobile",
  "version": "0.1.24",
  "description": "Lilypad mobile (bare React Native): QR scanner, viewer, dev input toolbar",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android",
    "pods": "cd ios && pod install && cd ..",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src App.tsx",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf node_modules/.cache"
  },
  "dependencies": {
    "@invertase/react-native-apple-authentication": "^2.5.1",
    "@lilypad/design": "workspace:*",
    "@lilypad/protocol": "workspace:*",
    "@noble/ed25519": "^3.1.0",
    "@noble/hashes": "^2.3.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@react-native-community/netinfo": "^11.4.1",
    "@react-native-google-signin/google-signin": "^16.1.4",
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "@sayem314/react-native-keep-awake": "^2.0.0",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-gesture-handler": "2.21.2",
    "react-native-get-random-values": "^2.0.0",
    "react-native-keychain": "^10.0.0",
    "react-native-safe-area-context": "^5.0.0",
    "react-native-screens": "4.4.0",
    "react-native-vision-camera": "^4.6.3",
    "react-native-webrtc": "^124.0.5"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-env": "^7.26.0",
    "@babel/runtime": "^7.26.0",
    "@react-native-community/cli": "15.0.1",
    "@react-native-community/cli-platform-android": "15.0.1",
    "@react-native-community/cli-platform-ios": "15.0.1",
    "@react-native/babel-preset": "0.76.5",
    "@react-native/codegen": "0.76.5",
    "@react-native/gradle-plugin": "0.76.5",
    "@react-native/metro-config": "0.76.5",
    "@react-native/typescript-config": "0.76.5",
    "@testing-library/react-native": "^12.9.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.18",
    "babel-jest": "^29.7.0",
    "jest": "^29.7.0",
    "react-test-renderer": "18.3.1",
    "typescript": "^5.7.3"
