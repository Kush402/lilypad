# iOS Fastfile — Lilypad mobile (bare React Native 0.76.5)
#
# `beta` lane: install pods, archive Release, export a signed App Store IPA and
# upload it to TestFlight. Auth is via an App Store Connect API key (.p8) so no
# Apple ID / 2FA session is needed in CI.
#
# Everything sensitive (key ids, team id, provisioning) is read from env. Signing
# defaults to Xcode-managed automatic signing (matches the checked-in project),
# but can be switched to `match` by setting MATCH_GIT_URL.

require 'base64'
require 'shellwords'
require 'tmpdir'

default_platform(:ios)

# --- helpers ---------------------------------------------------------------

# An unset GitHub Actions secret interpolates to the EMPTY STRING, not to
# nothing — and in Ruby `"" || "default"` is `""`. So every `ENV["X"] || "…"`
# below silently loses its default the moment a workflow passes a secret that
# was never created, which is exactly what `mobile-ios.yml` does for
# APPLE_TEAM_ID, IOS_APP_IDENTIFIER and FASTLANE_APPLE_ID. The result is
# `team_id: ""` and an app identifier of `""`, failing deep inside fastlane
# with a message about neither.
#
# `env` treats blank as absent, which is what the `||` chains always meant.
def env(name)
  value = ENV[name]
  value && !value.strip.empty? ? value.strip : nil
end

# xcodebuild needs the key as a FILE at an absolute path — it has no way to
# take inline content, and a relative path resolves against whatever directory
# xcodebuild happens to run in. CI already writes one and exports
# ASC_KEY_P8_PATH; this covers the ASC_KEY_P8-only case so both paths through
# `asc_api_key` above stay usable.
#
# 0600 and a temp dir, because this file can upload builds to the account.
# The flags that let xcodebuild talk to the developer portal without an Xcode
# account. See the comment on the automatic-signing branch for why they are not
# optional in CI.
def auth_args(key_path)
  [
    "-allowProvisioningUpdates",
    "-authenticationKeyPath", key_path,
    "-authenticationKeyID", env("ASC_KEY_ID"),
    "-authenticationKeyIssuerID", env("ASC_ISSUER_ID")
  ].map { |a| Shellwords.escape(a) }.join(" ")
end

def asc_key_path
  from_env = env("ASC_KEY_P8_PATH")
  return File.expand_path(from_env) if from_env && File.exist?(from_env)

  content = env("ASC_KEY_P8") || UI.user_error!("ASC_KEY_P8_PATH or ASC_KEY_P8 must be set")
  path = File.join(Dir.mktmpdir("asc-key"), "AuthKey.p8")
  File.write(path, Base64.decode64(content))
  File.chmod(0o600, path)
  at_exit { File.delete(path) if File.exist?(path) }
  path
end

def asc_api_key
  # Prefer a decoded .p8 file path (CI writes one from the base64 secret);
  # fall back to inline base64 content in ASC_KEY_P8 if no file is provided.
  key_filepath = env("ASC_KEY_P8_PATH")
  key_content  = env("ASC_KEY_P8")

  common = {
    key_id: env("ASC_KEY_ID") || UI.user_error!("ASC_KEY_ID is not set"),
    issuer_id: env("ASC_ISSUER_ID") || UI.user_error!("ASC_ISSUER_ID is not set"),
    duration: 1200,
    in_house: false
  }

  if key_filepath && File.exist?(key_filepath)
    app_store_connect_api_key(common.merge(key_filepath: key_filepath))
  elsif key_content
    app_store_connect_api_key(
      common.merge(key_content: key_content, is_key_content_base64: true)
    )
  else
    UI.user_error!(
      "No App Store Connect API key found. Set ASC_KEY_P8_PATH (a .p8 file) " \
      "or ASC_KEY_P8 (base64-encoded .p8 content)."
    )
  end
end

platform :ios do
  desc "Build a signed IPA and upload it to TestFlight"
  lane :beta do
    workspace  = env("IOS_WORKSPACE") || "LilypadMobile.xcworkspace"
    scheme     = env("IOS_SCHEME") || "LilypadMobile"
    app_id     = env("IOS_APP_IDENTIFIER") || "com.takedia.lilypad"
    team_id    = env("APPLE_TEAM_ID") || env("FASTLANE_TEAM_ID") || "AR2Q4Y465L"
    build_dir  = "build"
    output_ipa = "#{scheme}.ipa"

    api_key = asc_api_key
    key_path = asc_key_path

    # Keep the lane self-sufficient — CocoaPods is idempotent, so this is safe
    # even though CI also runs `pod install` before invoking the lane.
    cocoapods(
      podfile: "Podfile",
      try_repo_update_on_error: true
    )

    # Bump the build number to something unique per CI run so TestFlight never
    # rejects a duplicate. Overridable; defaults to the CI run number or epoch.
    build_number = env("IOS_BUILD_NUMBER") ||
                   env("GITHUB_RUN_NUMBER") ||
                   Time.now.to_i.to_s
    increment_build_number(
      xcodeproj: "LilypadMobile.xcodeproj",
      build_number: build_number
    )

    # Signing assets this account will actually issue. Xcode's *managed cloud
    # signing* — what plain automatic signing reaches for at export — needs a
    # role this App Store Connect key does not have; it fails with
    # "Cloud signing permission error / No signing certificate iOS Distribution
    # found" no matter how many times it is retried.
    #
    # A certificate and profile created through the API and handed in as
    # secrets sidestep that entirely, and are deterministic besides: an
    # ephemeral runner cannot reuse a certificate whose private key it does not
    # have, so cloud-less automatic signing would mint a fresh one every run
    # until the account hit its limit.
    #
    # The ARCHIVE still signs automatically — Xcode resolves a development
    # identity from the same API key, which works — and only the EXPORT is
    # manual. That is the combination verified end to end on 2026-08-24.
    if env("IOS_PROVISIONING_PROFILE_NAME")
      # --- explicit manual export ----------------------------------------
      build_app(
        workspace: workspace,
        scheme: scheme,
        configuration: "Release",
        export_method: "app-store",
        output_directory: build_dir,
        output_name: output_ipa,
        clean: true,
        xcargs: auth_args(key_path),
        export_xcargs: auth_args(key_path),
        export_options: {
          signingStyle: "manual",
          teamID: team_id,
          signingCertificate: env("IOS_SIGNING_IDENTITY") ||
                              UI.user_error!("IOS_SIGNING_IDENTITY is not set"),
          provisioningProfiles: { app_id => env("IOS_PROVISIONING_PROFILE_NAME") }
        }
      )
    elsif env("MATCH_GIT_URL")
      # --- manual signing via match --------------------------------------
      match(
        type: "appstore",
        app_identifier: app_id,
        git_url: env("MATCH_GIT_URL"),
        team_id: team_id,
        api_key: api_key,
        readonly: true
      )

      build_app(
        workspace: workspace,
        scheme: scheme,
        configuration: "Release",
        export_method: "app-store",
        output_directory: build_dir,
        output_name: output_ipa,
        clean: true,
        export_options: {
          signingStyle: "manual",
          teamID: team_id
        }
      )
    else
      # --- Xcode-managed automatic signing (default) ---------------------
      # -allowProvisioningUpdates lets Xcode create the App Store profile and a
      # managed cloud signing certificate, so nothing has to be pre-installed
      # and no certificate slot is burned on an ephemeral runner.
      #
      # On its own it does NOT work in CI. `xcodebuild -help`:
      #
      #   Requires a developer account to have been added in Xcode's Accounts
      #   settings or an App Store Connect authentication key to be specified
      #   via the -authenticationKeyPath, -authenticationKeyID, and
      #   -authenticationKeyIssuerID parameters.
      #
      # A runner has no Xcode account, and `build_app` has no api_key option to
      # supply one — `Gym::Options` offers none, so passing `api_key:` here is
      # silently ignored. The three flags below are the only route, and they
      # have to go to the export step as well: gym runs -exportArchive as a
      # separate xcodebuild invocation that re-signs, and it does not inherit
      # `xcargs`.
      build_app(
        workspace: workspace,
        scheme: scheme,
        configuration: "Release",
        export_method: "app-store",
        output_directory: build_dir,
        output_name: output_ipa,
        clean: true,
        xcargs: auth_args(key_path),
        export_xcargs: auth_args(key_path),
        export_options: {
          signingStyle: "automatic",
          teamID: team_id
        }
      )
    end

    upload_to_testflight(
      api_key: api_key,
      ipa: "#{build_dir}/#{output_ipa}",
      skip_waiting_for_build_processing: true,
      skip_submission: true
    )
  end
end
