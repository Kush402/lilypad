# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'LilypadMobile' do
  config = use_native_modules!

  # Sign in with Google pulls in GoogleSignIn -> AppCheckCore, which is Swift and
  # cannot import these two Objective-C pods unless they generate module maps.
  # Without this, `pod install` fails outright and the app cannot be built.
  # Scoped to the two offending pods on purpose: `use_modular_headers!` globally
  # would change header semantics for every React Native pod as well.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'RecaptchaInterop', :modular_headers => true

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  target 'LilypadMobileTests' do
    inherit! :complete
    # Pods for testing
  end

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Strip extended attributes from every framework before it is signed.
    #
    # A checkout inside an iCloud-synced folder — `~/Desktop` and `~/Documents`
    # are synced by default, and this repo lives in one — has
    # `com.apple.FinderInfo` stamped on its files by the sync agent. `codesign`
    # refuses outright:
    #
    #     resource fork, Finder information, or similar detritus not allowed
    #
    # This line used to be added BY HAND to the generated
    # `Pods-*-frameworks.sh`, which `pod install` overwrites — so the local iOS
    # build broke again on the next install, silently, every time, and the fix
    # had to be rediscovered. Regenerating it here is the difference between a
    # workaround and a fix.
    #
    # Harmless where it is not needed (CI checkouts carry no such attributes),
    # and `|| true` so a file with nothing to strip is not an error.
    installer.sandbox.target_support_files_root.glob('*/Pods-*-frameworks.sh').each do |script|
      body = script.read
      next if body.include?('xattr -cr')

      anchor = '    local code_sign_cmd='
      next unless body.include?(anchor)

      script.write(body.sub(anchor, "    xattr -cr \"$1\" 2>/dev/null || true\n#{anchor}"))
      Pod::UI.puts "Patched #{script.basename} to strip extended attributes before signing".green
    end
  end
end
