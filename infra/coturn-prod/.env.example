# Copy to `.env` and fill in. Never commit the real .env.

# The VPS's PUBLIC IPv4 address (what `curl -4 ifconfig.co` returns on the box).
TURN_PUBLIC_IP=203.0.113.10

# The DNS name you point at TURN_PUBLIC_IP (an A record). Used as the TLS realm
# and the hostname clients connect to on turns:...:443. e.g. turn.example.com
TURN_DOMAIN=turn.example.com

# MUST be identical to the backend's TURN_SECRET (root .env). Generate a strong
# one: `openssl rand -hex 32`. The backend derives per-session HMAC credentials
# from this; coturn re-derives and verifies them.
TURN_SECRET=replace-with-openssl-rand-hex-32
