# Lilypad production control plane — copy to .env.production ON THE SERVER.
#
# NEVER commit the filled-in file. .gitignore already excludes .env*; verify
# with `git check-ignore -v .env.production` before you touch anything.
#
# Generate every secret fresh. loadEnv() refuses to boot in production if any
# still matches a dev default, if TURN_SECRET/AUTH_TOKEN_SECRET are under 32
# characters, if METRICS_BEARER_TOKEN is unset, if the public URLs are not
# https/wss, or if REDIS_URL carries no password.
#
#   openssl rand -hex 32

NODE_ENV=production

# ── Postgres (compose-internal; never published to the host) ────────────────
POSTGRES_USER=lilypad
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=lilypad
DATABASE_URL=postgres://lilypad:CHANGE_ME@postgres:5432/lilypad

# ── Redis (compose-internal; password mandatory) ────────────────────────────
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ── Public identity ─────────────────────────────────────────────────────────
PUBLIC_BASE_URL=https://api.takedia.com
SIGNALING_URL=wss://api.takedia.com/ws/signal
# Comma-separated allowlist; fails closed, so an unlisted origin gets no CORS
# header at all. The mobile and desktop apps are not browsers and are
# unaffected — this protects the future web dashboard.
ALLOWED_ORIGINS=https://app.takedia.com

# ── Secrets (32+ chars each) ────────────────────────────────────────────────
AUTH_TOKEN_SECRET=CHANGE_ME
METRICS_BEARER_TOKEN=CHANGE_ME

# ── TURN (coturn runs in its own stack — see ../coturn-prod) ────────────────
# Must match the coturn box's static-auth-secret exactly, or every credential
# the backend mints is rejected by the relay.
TURN_SECRET=CHANGE_ME
TURN_REALM=takedia.com
STUN_URL=stun:turn.takedia.com:3478
TURN_URL=turn:turn.takedia.com:3478
# Advertised in addition to the above so a UDP-blocked network still connects.
PUBLIC_TURN_URL=turn:turn.takedia.com:3478,turns:turn.takedia.com:443?transport=tcp

# ── Ingress ─────────────────────────────────────────────────────────────────
# From: Cloudflare Zero Trust → Networks → Tunnels → your tunnel → install.
CLOUDFLARE_TUNNEL_TOKEN=CHANGE_ME

# ── Entitlements (ADR-0016) ─────────────────────────────────────────────────
# Whether /connect/request refuses an account without a remote-access
# subscription. Leave it false: /connect/request is on the path of EVERY
# session including one on the customer's own Wi-Fi, so turning this on today
# would charge for LAN, which ADR-0013 forbids. Turn it on only once a LAN
# session no longer reaches the cloud at all. Until then the check runs, logs
# what it would have refused, and allows the session.
ENFORCE_REMOTE_ENTITLEMENT=false

# ── App Store billing (ADR-0016) ────────────────────────────────────────────
# Verifies StoreKit JWS + App Store Server Notifications V2. Without these,
# POST /billing/apple/* answers 503. APPLE_APP_APPLE_ID is the App Store
# Connect app record for Lilypad RC.
APPLE_IAP_BUNDLE_ID=com.takedia.lilypad
APPLE_APP_APPLE_ID=6804827369
APPLE_IAP_ENVIRONMENT=Production

# ── Outbound mail ───────────────────────────────────────────────────────────
# Both are required together. Without them /auth/magic-link/request and
# /auth/password/reset/request answer 503 rather than accepting a sign-in whose
# email will never arrive. MAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Lilypad <no-reply@takedia.com>

# ── OAuth (see docs/oauth-setup.md) ─────────────────────────────────────────
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=com.takedia.lilypad

# Trusted proxy addresses in front of this origin. Production cloudflared
# connects from the private Docker network; `uniquelocal` trusts that connector
# without trusting a public client that reaches an origin directly. Leaving
# this unset makes every client share one rate-limit bucket. Set to `false`
# only for an origin exposed directly with no proxy.
TRUST_PROXY=uniquelocal
