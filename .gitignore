dist/
build/
out/
*.tsbuildinfo
.vite/
.cxx/

# Rust / Tauri
apps/desktop/src-tauri/target/
apps/desktop/src-tauri/gen/

# React Native
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/build-device/
apps/mobile/ios/build-release/
